# EmailJS Configuration
# Copy this file to .env.local for local development and replace the placeholders below
# For deployment on Vercel, add the same values in Project Settings > Environment Variables
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# IMPORTANT:
# 1. Create a Gmail service in EmailJS.
# 2. Create a template with these variable names: from_name, reply_to, subject, message
# 3. Use your Gmail account as the sender email.
# 4. Never commit .env.local to GitHub.
# 5. Get the keys here: https://www.emailjs.com/
