# EmailJS Configuration (Public - safe to expose)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# SMTP Configuration (Server-side - keep secret)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_email_address@gmail.com
SMTP_PASS=your_app_password_here
RECEIVER_EMAIL=patilmanojkumar35@gmail.com

# Instructions:
# 1. Copy this file to .env.local (for local development)
# 2. Fill in the actual values for your services
# 3. Never commit .env.local to git - it's in .gitignore
# 4. For Vercel deployment, add these variables in Project Settings > Environment Variables
#
# How to get these values:
# - EmailJS: https://www.emailjs.com/ (Get IDs from dashboard)
# - Gmail SMTP: Enable 2-factor auth, generate App Password
# - SMTP Host for Gmail: smtp.gmail.com
